{
  "expo": {
    "name": "DietBridge",
    "slug": "dietbridge",
    "version": "1.0.0",
    "scheme": "dietbridge",
    "icon": "./assets/app-icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "android": {
      "package": "com.dietbridge.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "ios": {
      "bundleIdentifier": "com.dietbridge.app",
      "buildNumber": "1"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "DietBridge fotoğraf seçebilmek için fotoğraflarınıza erişim izni ister.",
          "cameraPermission": "DietBridge fotoğraf çekebilmek için kamera izni ister.",
          "microphonePermission": false
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "51259ad9-2efb-4393-9e40-8c22238a5cf8"
      }
    },
    "owner": "samet_app"
  }
}
