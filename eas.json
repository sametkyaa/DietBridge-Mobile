{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "developmentClient": true,
      "node": "24.17.0"
    },
    "preview": {
      "distribution": "internal",
      "node": "24.17.0",
      "env": {
        "EXPO_PUBLIC_ENABLE_HEALTH_CONSENT": "true"
      }
    },
    "production": {
      "node": "24.17.0",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ENABLE_HEALTH_CONSENT": "true"
      }
    }
  }
}
