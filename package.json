{
  "name": "dietbridge",
  "version": "1.0.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint App.js apps/mobile/src scripts",
    "test": "node --test",
    "test:water": "node --test apps/mobile/src/features/clients/services/__tests__/dailyWaterContract.test.cjs",
    "test:appointments": "node --test \"apps/mobile/src/features/appointments/utils/__tests__/*.test.cjs\" \"apps/mobile/src/features/appointments/services/__tests__/*.test.cjs\"",
    "test:notifications": "node --test \"apps/mobile/src/features/notifications/utils/__tests__/*.test.cjs\" \"apps/mobile/src/features/notifications/services/__tests__/*.test.cjs\"",
    "test:push": "node --test apps/mobile/src/features/push/utils/__tests__/pushClientPolicy.test.cjs apps/mobile/src/features/push/services/__tests__/pushClientServiceContract.test.cjs apps/mobile/src/features/push/services/__tests__/pushLifecycleController.test.cjs",
    "test:push:backend": "node scripts/runDisposablePushClientBackendIntegration.mjs",
    "expo:config": "expo config --type public",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "quality": "npm run typecheck && npm run lint && npm run test && npm run expo:config && npm run export:android && npm run export:ios"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.10.1",
    "@supabase/supabase-js": "^2.84.0",
    "expo": "~54.0.36",
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-notifications": "~0.32.17",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@types/react": "~19.1.10",
    "eslint": "^9.39.2",
    "eslint-config-expo": "^10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
