EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Password recovery uses the native dietbridge://reset-password deep link.
# Chat image sending is opt-in and stays disabled unless this is exactly 'true'.
# The backend image RPCs are dormant, so the default must remain false.
EXPO_PUBLIC_ENABLE_CHAT_IMAGES=false

# Enable only after the dormant backend, legal text and rollout gates are approved.
EXPO_PUBLIC_ENABLE_HEALTH_CONSENT=false
