EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Production builds must use the canonical HTTPS recovery route below.
EXPO_PUBLIC_WEB_RESET_PASSWORD_URL=https://app.dietbridge.com.tr/reset-password
# Local development may explicitly override the value in the untracked .env only:
# EXPO_PUBLIC_WEB_RESET_PASSWORD_URL=http://localhost:5173/reset-password
# Chat image sending is opt-in and stays disabled unless this is exactly 'true'.
# The backend image RPCs are dormant, so the default must remain false.
EXPO_PUBLIC_ENABLE_CHAT_IMAGES=false
